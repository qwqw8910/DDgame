{
  "name": "dongwo-server",
  "version": "1.0.0",
  "description": "懂我再說 — Socket.io 遊戲後端伺服器",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:integration": "node --test --test-force-exit --test-concurrency=1 \"tests/integration/*.test.js\"",
    "test": "npm run test:unit && npm run test:integration"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.4",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.3"
  }
}
